# Codebase Self-Evolving Agent Configuration
# Provide at least one API key (Gemini or Groq) for AI-powered agents.
# If omitted, the system operates in offline static analysis mode.

# LLM Providers (Optional for local static demo, recommended for full autonomous loop)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Server & Deployment Configuration
PORT=8000
HOST=0.0.0.0

# Security: Set DEMO_MODE=true for public demonstrations to sandbox filesystem access and prevent branch mutations
DEMO_MODE=false
